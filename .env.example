# Copy to .env and fill in what you need. Everything here is optional: the app runs with none of it.

# Fallback 2D map, used only when the browser has no WebGL for the 3D globe.
# A Google Maps JavaScript API browser key, restricted by HTTP referrer.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# AI comparison synthesis. Works with any OpenAI-compatible chat completions API
# (set the provider's base URL, your key and a model it serves). Server-side only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Shows the synthesis panel in the UI. Set to "on" only when the three values above are filled.
VITE_AI_SYNTHESIS=
